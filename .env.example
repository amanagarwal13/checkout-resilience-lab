# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox).
# Link the app to a US sandbox Business account with Advanced Credit and
# Debit Card Payments enabled: the test shoppers pay with PayPal's test cards.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# OpenAI key for the AI test shoppers, the store's support bot, the
# investigator and the dashboard assistant.
OPENAI_API_KEY=
# Optional model overrides
# OPENAI_MODEL=gpt-5-mini
# OPENAI_INVESTIGATOR_MODEL=gpt-5.5
# OPENAI_STUDIO_MODELS=gpt-5.6-terra,gpt-5-mini

# Optional: AG Studio licence key (removes the trial watermark on /dashboard).
AG_STUDIO_LICENSE_KEY=

# Optional: how many test shoppers run at once in the web interface.
# MAX_PARALLEL=3
