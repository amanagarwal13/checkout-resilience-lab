{
  "name": "checkout-resilience-lab",
  "version": "0.1.0",
  "description": "Stress tests for PayPal checkouts, run by AI shoppers",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amanagarwal13/checkout-resilience-lab.git"
  },
  "homepage": "https://github.com/amanagarwal13/checkout-resilience-lab#readme",
  "bugs": "https://github.com/amanagarwal13/checkout-resilience-lab/issues",
  "keywords": [
    "paypal",
    "checkout",
    "payments",
    "testing",
    "stress-testing",
    "fault-injection",
    "ai-agents",
    "playwright",
    "mcp"
  ],
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "start": "tsx src/server/server.ts",
    "dev": "tsx src/dev.ts",
    "stress": "tsx src/lab/stress.ts",
    "fix": "tsx src/lab/fix.ts",
    "eval": "tsx src/lab/eval.ts",
    "smoke": "tsx src/smoke.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "stress:paypal-example": "tsx src/lab/stressPayPalExample.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@paypal/paypal-server-sdk": "^2.5.0",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "ag-studio": "^3.0.0",
    "ag-studio-react": "^3.0.0",
    "axios": "^1.20.0",
    "hono": "^4.13.13",
    "openai": "^7.39.0",
    "playwright": "^1.64.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "body-parser": "^1.20.8",
    "dotenv": "^16.6.1",
    "esbuild": "^0.28.2",
    "express": "^4.22.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
